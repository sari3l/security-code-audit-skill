{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timeresearch.biz/security-code-audit/plugins/onyx/config.schema.json",
  "title": "Onyx Code Audit Connector Configuration",
  "description": "Declarative defaults or user overrides for the Onyx requirement connector. Credentials are never valid configuration fields.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "configEnv": {
      "$ref": "#/$defs/environmentVariable",
      "description": "Host-forwarded path variable declared by the bundled config; user overrides cannot change it."
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^#]+$"
    },
    "tokenEnv": {
      "$ref": "#/$defs/environmentVariable",
      "description": "Host-forwarded credential variable declared by the bundled config; user overrides cannot change it."
    },
    "searchTool": {
      "$ref": "#/$defs/toolName"
    },
    "fetchTool": {
      "$ref": "#/$defs/toolName"
    },
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "$ref": "#/$defs/optionalToolName"
        },
        "limit": {
          "$ref": "#/$defs/optionalToolName"
        },
        "documentId": {
          "$ref": "#/$defs/optionalToolName"
        }
      }
    },
    "staticArguments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "search": {
          "$ref": "#/$defs/staticArguments"
        },
        "fetch": {
          "$ref": "#/$defs/staticArguments"
        }
      }
    },
    "enabled": {
      "type": "boolean"
    }
  },
  "$defs": {
    "environmentVariable": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
    },
    "toolName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "optionalToolName": {
      "oneOf": [
        {
          "$ref": "#/$defs/toolName"
        },
        {
          "type": "null"
        }
      ]
    },
    "staticArguments": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": ["boolean", "number", "string", "null"]
          },
          {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": ["boolean", "number", "string", "null"]
            }
          }
        ]
      }
    }
  }
}
