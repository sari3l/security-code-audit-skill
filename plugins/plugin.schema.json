{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sari3l/security-code-audit-skill/main/plugin.schema.json",
  "title": "Security Code Audit Plugin",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "enabled",
    "capabilities",
    "entrypoints",
    "config",
    "report",
    "lifecycle"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "enabled": {
      "type": "boolean"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mcp": {
          "$ref": "#/$defs/localPath"
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/localPath"
          }
        },
        "web": {
          "$ref": "#/$defs/localPath"
        }
      },
      "anyOf": [
        {
          "required": [
            "mcp"
          ]
        },
        {
          "required": [
            "skills"
          ]
        }
      ],
      "dependentRequired": {
        "web": [
          "mcp"
        ]
      }
    },
    "config": {
      "$ref": "#/$defs/localPath"
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heading",
        "guide"
      ],
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "guide": {
          "$ref": "#/$defs/localPath"
        },
        "context": {
          "$ref": "#/$defs/stateArtifact"
        },
        "rows": {
          "$ref": "#/$defs/stateArtifact"
        },
        "review": {
          "$ref": "#/$defs/stateArtifact"
        },
        "rowKey": {
          "$ref": "#/$defs/fieldName"
        },
        "summary": {
          "$ref": "#/$defs/fieldList"
        },
        "columns": {
          "$ref": "#/$defs/fieldList"
        }
      },
      "dependentRequired": {
        "rows": [
          "context",
          "rowKey",
          "columns"
        ],
        "review": [
          "rows"
        ],
        "rowKey": [
          "rows"
        ],
        "columns": [
          "rows"
        ],
        "summary": [
          "context"
        ]
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "after",
        "before",
        "failure"
      ],
      "properties": {
        "after": {
          "$ref": "#/$defs/phase"
        },
        "before": {
          "$ref": "#/$defs/phase"
        },
        "failure": {
          "enum": [
            "continue",
            "coverage-debt",
            "abort"
          ]
        }
      }
    }
  },
  "$defs": {
    "localPath": {
      "type": "string",
      "pattern": "^\\./[^\\u0000]+$"
    },
    "fieldName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "fieldList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "label"
        ],
        "properties": {
          "field": {
            "$ref": "#/$defs/fieldName"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "link": {
            "$ref": "#/$defs/fieldName"
          }
        }
      }
    },
    "stateArtifact": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "phase": {
      "enum": [
        "audit-start",
        "architecture-and-change-recon",
        "security-semantic-review",
        "coverage-verification",
        "report-finalization",
        "audit-complete"
      ]
    }
  }
}
